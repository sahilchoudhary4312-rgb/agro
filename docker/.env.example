# AgriMitra — Docker deployment configuration
#
# Copy this file to `docker/.env` and fill in real values before running:
#   cd docker && docker compose --env-file .env up --build
#
# NEVER commit a real .env file or real secrets to source control.

# --- Required ---
# Long random string (>= 32 chars). Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Password for the PostgreSQL container
POSTGRES_PASSWORD=

# --- Optional (defaults shown) ---
POSTGRES_DB=agrimitra
POSTGRES_USER=agrimitra
FRONTEND_PORT=8080
CORS_ORIGINS=http://localhost:8080
# Set to false to skip DEMO DATA seeding on an empty database
SEED_ON_STARTUP=true
