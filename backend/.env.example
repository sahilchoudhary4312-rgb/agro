# AgriMitra backend environment variables
# Copy to .env and adjust values. NEVER commit real .env files.

# SQLAlchemy connection string.
# Default (local dev, zero setup): SQLite file in backend/
# For docker-compose / production use:
#   postgresql+psycopg://agrimitra:agrimitra@db:5432/agrimitra
DATABASE_URL=sqlite:///./agrimitra.db

# Secret used to sign JWTs. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Token lifetimes (minutes / days)
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=14

# Comma-separated allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Market data source: "demo" (seeded DEMO DATA) or "live" (falls back to demo until an
# AGMARKNET/eNAM integration is configured)
MARKET_DATA_PROVIDER=demo

# Seed the database with demo data on first startup (DEMO DATA, clearly labelled in UI)
SEED_ON_STARTUP=true

# Default recommendation weights (percent; also editable at runtime from Admin > System settings)
WEIGHT_NET_REALIZATION=35
WEIGHT_BUYER_RELIABILITY=20
WEIGHT_QUALITY_MATCH=15
WEIGHT_QUANTITY_MATCH=10
WEIGHT_DISTANCE=10
WEIGHT_PRICE_OUTLOOK=10
